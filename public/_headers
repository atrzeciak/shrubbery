/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # cloudflareinsights.com is not referenced anywhere under public/ and never will be: the zone
  # injects its analytics beacon into every HTML response after the Worker has returned it. The
  # policy admits it because refusing only produced a console error, not a blocked page view.
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache
